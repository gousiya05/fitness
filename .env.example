# =====================================================================
# FitAI — Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================================

# Gemini AI API Key — required for Gemini AI workout/diet generation
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL — auto-injected by AI Studio / Cloud Run at runtime
APP_URL="MY_APP_URL"

# MongoDB URI (optional) — set to enable persistent user profiles
# Example: mongodb+srv://user:pass@cluster.mongodb.net/fitai
# Leave blank to use in-memory/localStorage fallback mode
# MONGODB_URI=

# JWT Secret — used to sign auth tokens. Change this in production!
JWT_SECRET="fitai-super-secret-jwt-key-change-me-in-production"

# =====================================================================
# ML Backend (FastAPI Python server)
# =====================================================================
# The URL where the FastAPI ML backend is running.
# Local dev default: http://localhost:8000
# Production: set to your Render/Railway deployment URL
VITE_ML_API_URL="http://localhost:8000"
