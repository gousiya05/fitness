# ─────────────────────────────────────────────────────────────────────────────
# FlexAI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret-string

# ── ML Backend (FastAPI / Python) ────────────────────────────────────────────
# Local development: leave as localhost:8000 (default — no need to set)
# Production (Vercel): set this to your deployed FastAPI URL on Render/Railway
ML_BACKEND_URL=http://localhost:8000

# ── MongoDB (optional) ───────────────────────────────────────────────────────
# If not set, the app uses in-memory/localStorage mode (no persistence)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/flexai

# ── Gemini AI (optional — only needed for AI features) ───────────────────────
# Required ONLY for:
#   - Food Scanner (AI image analysis)
#   - AI Fitness Coach / Chatbot
#   - Gemini-powered workout plans
#
# NOT required for:
#   - BMI calculation (local formula + ML model)
#   - Calorie prediction (ML model)
#   - Workout recommendations (ML model)
#   - Algorithm Lab (scikit-learn, no AI)
#   - Pose Detector (MediaPipe, runs in browser)
#
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Override ML API URL for direct FastAPI access (skips Express proxy)
# Leave unset to use the Express proxy at /api/ml (recommended)
# VITE_ML_API_URL=http://localhost:8000
