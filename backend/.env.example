# =====================================================================
# FitAI — Backend Environment Variables
# Copy to backend/.env and fill in values for production
# =====================================================================

# Port the FastAPI server listens on (default: 8000)
PORT=8000

# Allowed CORS origins (comma-separated). Use * for dev.
# Production example: https://fitai.vercel.app,https://www.fitai.com
ALLOWED_ORIGINS=*
